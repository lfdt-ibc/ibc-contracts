# Copy to compose.env and replace every path with an absolute host path. This
# file contains deployment paths only; secrets remain in operator.env.

PRIVIDIUM_PROOF_API_IMAGE=prividium-proof-api:hard-finality
PRIVIDIUM_RUN_UID=1000
PRIVIDIUM_RUN_GID=1000

# Directory containing exactly the four reviewed hard-finality ELF files.
PRIVIDIUM_CIRCUIT_ELF_DIR=/absolute/path/to/reviewed/elfs

# Directory containing source-profile.json. Docker uses this directory as the
# named source-profile build context and mounts the same file at runtime.
PRIVIDIUM_SOURCE_PROFILE_CONTEXT=/absolute/path/to/source-profile-context

# Reviewed release files generated from the same SourceProfile and commit.
PRIVIDIUM_PROGRAM_VKEYS_FILE=/absolute/path/to/program-vkeys.json
PRIVIDIUM_INITIAL_TRUST_FILE=/absolute/path/to/initial-trust.json

# Mode-0600 operator environment file. Artifact paths inside this file are
# ignored in container mode and replaced by the fixed container paths.
PRIVIDIUM_OPERATOR_ENV_FILE=/absolute/path/to/operator.container.env

# Host-owned persistent directory for the generated config.json.
PRIVIDIUM_STATE_DIRECTORY=/absolute/path/to/prividium-l1-proof-api-state

# Must match the port in PRIVIDIUM_BIND_ADDRESS.
PRIVIDIUM_PROOF_API_PORT=9095
