# Copy this file outside the repository, replace every deployment-specific
# value, and protect it with: chmod 600 /absolute/path/operator.env
# This file is sourced by Bash. Put single quotes around URLs or secrets that
# contain shell characters such as &, ?, #, spaces, or $.

# Reviewed settlement-backed hard-finality release artifacts. All four ELFs and the light client
# must be built from this SourceProfile and VKey manifest.
PRIVIDIUM_SOURCE_PROFILE=/opt/prividium/release/source-profile.json
PRIVIDIUM_SP1_ELF_DIR=/opt/prividium/release/elfs
PRIVIDIUM_PROGRAM_VKEYS=/opt/prividium/release/program-vkeys.json
PRIVIDIUM_INITIAL_TRUST_PATH=/etc/prividium-l1-proof-api/initial-trust.json

# Build before starting on a host. The container image overrides this to false
# because it already contains the reviewed ELF-bound binary.
PRIVIDIUM_BUILD_OPERATOR=true
PRIVIDIUM_PROOF_API_BINARY=/usr/local/bin/prividium-proof-api
PRIVIDIUM_CONFIG_PATH=/etc/prividium-l1-proof-api/config.json

# Relayer-facing client identity and destination Router prefix.
PRIVIDIUM_BIND_ADDRESS=127.0.0.1:9095
PRIVIDIUM_CLIENT_CHAIN_ID=destination-chain
PRIVIDIUM_CLIENT_ID=prividium-0
PRIVIDIUM_COUNTERPARTY_CLIENT_ID=destination-0
PRIVIDIUM_COUNTERPARTY_MERKLE_PREFIX_JSON='["0x"]'

# SP1 network.
PRIVIDIUM_SP1_NETWORK_RPC_URL='https://sp1-gateway.example.com'
PRIVIDIUM_SP1_PROOF_TIMEOUT_SECONDS=3600
PRIVIDIUM_SP1_NETWORK_PRIVATE_KEY=0xREPLACE_WITH_32_BYTE_SECP256K1_KEY

# Source ZKsync L2.
PRIVIDIUM_L2_RPC_URL='https://prividium-l2.example.com'
PRIVIDIUM_L2_CHAIN_ID=6565
PRIVIDIUM_L2_RPC_TOKEN=
PRIVIDIUM_L2_RPC_MAX_RESPONSE_BYTES=16777216
PRIVIDIUM_L2_RPC_MAX_BATCH_LOOKBACK=2048

# Settlement L1 execution RPC.
PRIVIDIUM_L1_RPC_URL='https://l1-execution.example.com'
PRIVIDIUM_L1_CHAIN_ID=1
PRIVIDIUM_L1_RPC_TOKEN=
PRIVIDIUM_L1_RPC_MAX_RESPONSE_BYTES=16777216

# Beacon API and reviewed bootstrap values.
PRIVIDIUM_BEACON_URL='https://l1-beacon.example.com'
PRIVIDIUM_BEACON_TOKEN=
PRIVIDIUM_BEACON_MAX_RESPONSE_BYTES=16777216
PRIVIDIUM_FINALIZED_CHECKPOINT_ROOT=0xREPLACE_WITH_32_BYTE_ROOT
PRIVIDIUM_SOURCE_PROFILE_ID=0xREPLACE_WITH_32_BYTE_SOURCE_PROFILE_ID
PRIVIDIUM_SYNC_COMMITTEE_SIZE=512
PRIVIDIUM_SLOTS_PER_EPOCH=32
PRIVIDIUM_EPOCHS_PER_SYNC_COMMITTEE_PERIOD=256

# Source IBC storage and native-root probe. These fields must match the
# reviewed SourceProfile exactly.
PRIVIDIUM_IBC_SUPPORTED_PATH_SHAPE_ID=ibc-eureka-v2-terminal-path-v1
PRIVIDIUM_IBC_STORAGE_PROFILE_ID=cosmos-solidity-ibc-eureka-erc7201-v1
PRIVIDIUM_IBC_STORE_ADDRESS=0x1111111111111111111111111111111111111111
PRIVIDIUM_IBC_MAPPING_BASE_SLOT=0x1260944489272988d9df285149b5aa1b0f48f2136d6f416159f840a3e0747600
PRIVIDIUM_IBC_NATIVE_ROOT_PROBE_SLOT=0xREPLACE_WITH_32_BYTE_SLOT
PRIVIDIUM_MAX_CLIENT_ID_BYTES=128
PRIVIDIUM_ABSENCE_PROFILE_ID=1

# Destination Router, verifier and trust-update signer. The active light-client address
# is deliberately resolved through Router.getClient(PRIVIDIUM_CLIENT_ID).
PRIVIDIUM_DESTINATION_RPC_URL='https://destination-besu.example.com'
PRIVIDIUM_DESTINATION_CHAIN_ID=1337
PRIVIDIUM_DESTINATION_RPC_TOKEN=
PRIVIDIUM_DESTINATION_RPC_MAX_RESPONSE_BYTES=16777216
PRIVIDIUM_DESTINATION_ROUTER_ADDRESS=0x2222222222222222222222222222222222222222
PRIVIDIUM_DESTINATION_VERIFIER_ADDRESS=0x3333333333333333333333333333333333333333
PRIVIDIUM_TRUST_UPDATE_REGISTRAR_PRIVATE_KEY=0xREPLACE_WITH_32_BYTE_SECP256K1_KEY
PRIVIDIUM_TRUST_UPDATE_RECEIPT_TIMEOUT_SECONDS=120
PRIVIDIUM_TRUST_UPDATE_RECEIPT_POLL_MILLISECONDS=1000
PRIVIDIUM_TRUST_UPDATE_MAX_GAS=8000000

# Settlement Diamond storage binding.
PRIVIDIUM_SETTLEMENT_DIAMOND_PROXY_ADDRESS=0x4444444444444444444444444444444444444444
PRIVIDIUM_SETTLEMENT_STORED_BATCH_HASH_MAPPING_BASE_SLOT=0xREPLACE_WITH_32_BYTE_SLOT
PRIVIDIUM_SETTLEMENT_TOTAL_BATCHES_EXECUTED_SLOT=0xREPLACE_WITH_32_BYTE_SLOT

# Incoming Proof API authentication. It may be empty only for a loopback bind.
PRIVIDIUM_PROOF_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Request admission and automatic Trust Update catch-up.
PRIVIDIUM_REQUEST_TIMEOUT_SECONDS=1800
PRIVIDIUM_MAX_CONCURRENT_REQUESTS=4
PRIVIDIUM_MAX_QUEUED_REQUESTS=16
PRIVIDIUM_MAX_CONCURRENT_HEIGHT_REQUESTS=16
PRIVIDIUM_MAX_AUTOMATIC_TRUST_UPDATES=8
