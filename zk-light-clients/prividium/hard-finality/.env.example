# Guest build. Replace this development fixture with a reviewed production
# profile before generating release ELFs or VKeys.
PRIVIDIUM_SOURCE_PROFILE=profiles/example.synthetic.json

# Source Beacon REST API.
BEACON_API_URL=
BEACON_API_TOKEN=

# Source settlement execution JSON-RPC.
L1_EXECUTION_RPC_URL=
L1_EXECUTION_RPC_TOKEN=

# Prividium/ZKsync OS JSON-RPC.
PRIVIDIUM_L2_RPC_URL=
PRIVIDIUM_L2_RPC_TOKEN=

# Standalone Proof API. The exact environment-variable names are selected in
# tooling/proof-api/config.json; these names match config.example.json.
PRIVIDIUM_PROOF_API_TOKEN=
PRIVIDIUM_PROOF_BACKEND_TOKEN=
PRIVIDIUM_L1_RPC_TOKEN=
PRIVIDIUM_DESTINATION_RPC_TOKEN=
PRIVIDIUM_BEACON_TOKEN=

# Destination EVM JSON-RPC.
DESTINATION_RPC_URL=
DESTINATION_RPC_TOKEN=

# E2E Foundry broadcaster only. Keep real keys outside the repository.
PRIVATE_KEY=

# Light-client constructor inputs.
SOURCE_PROFILE_ID=
INITIAL_FINALIZED_SLOT=
INITIAL_FINALIZED_ROOT=
INITIAL_CURRENT_COMMITTEE_ROOT=
INITIAL_NEXT_COMMITTEE_ROOT=
INITIAL_NEXT_COMMITTEE_KNOWN=false
TRUST_UPDATE_VKEY=
SETTLEMENT_UPDATE_VKEY=
MEMBERSHIP_VKEY=
NON_MEMBERSHIP_VKEY=
ABSENCE_PROFILE_ID=1
IBC_STORE_ADDRESS=
IBC_ROUTER=

# Existing deployed client used by E2E proof-submission helpers.
CLIENT_ADDRESS=

# Real proof artifacts used only by the matching E2E script.
TRUST_PUBLIC_VALUES=
TRUST_PROOF=
SETTLEMENT_PUBLIC_VALUES=
SETTLEMENT_PROOF=
MEMBERSHIP_PUBLIC_VALUES=
MEMBERSHIP_PROOF=
MEMBERSHIP_PATH=
MEMBERSHIP_VALUE=
NON_MEMBERSHIP_PUBLIC_VALUES=
NON_MEMBERSHIP_PROOF=
NON_MEMBERSHIP_PATH=
